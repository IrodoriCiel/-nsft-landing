{
  // NSFT — sitio oficial de la extensión.
  //
  // Worker de solo estáticos: no hay código, únicamente la carpeta `public`
  // que publica `npm run landing:publish` desde el repositorio de la extensión.
  // Cloudflare lo despliega con `npx wrangler deploy` en cada push.
  "name": "nsft-landing-page",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public",
    // /privacidad -> /privacidad.html, y / -> /index.html
    "html_handling": "auto-trailing-slash"
  }
}
